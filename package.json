{
  "name": "gethome-hub",
  "version": "0.1.0",
  "description": "GetHome Hub — a local smart-home hub hosting Matter, Zigbee (via Zigbee2MQTT), and MQTT devices behind one canonical device schema.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc && mkdir -p dist/db && cp -r src/db/migrations dist/db/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "~0.3.211",
    "@fastify/websocket": "^11.2.0",
    "@homebridge/ciao": "^1.3.9",
    "@matter/main": "~0.17.4",
    "@project-chip/matter.js": "~0.17.4",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.10.0",
    "mqtt": "^5.15.2",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
