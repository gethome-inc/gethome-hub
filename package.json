{
  "name": "gethome-hub",
  "version": "0.1.0",
  "description": "GetHome Hub — a local smart-home hub hosting Matter, Zigbee (via Zigbee2MQTT), and MQTT devices behind one canonical device schema.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc && mkdir -p dist/db && cp -r src/db/migrations dist/db/",
    "typecheck": "tsc --noEmit && npm run typecheck:test",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@fastify/websocket": "^11.3.0",
    "@homebridge/ciao": "^1.3.12",
    "@matter/main": "~0.17.9",
    "@project-chip/matter.js": "~0.17.9",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.0",
    "mqtt": "^5.15.2",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
