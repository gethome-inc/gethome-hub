# GetHome Hub configuration.
# Copy to .env for local development (npm run dev reads it via --env-file-if-exists).
# On a Pi, deploy/install.sh writes the same settings to /etc/gethome/hub.env.

# HTTP API + WebSocket port.
PORT=8420

# Where the hub's SQLite file lives. Defaults to <DATA_DIR>/hub.db, which is
# almost always what you want — there is no server to point at.
# DATABASE_FILE=./data/hub.db

# MQTT broker (Mosquitto). Zigbee2MQTT and GetHome MQTT integrations meet here.
MQTT_URL=mqtt://127.0.0.1:1883

# Base topic Zigbee2MQTT publishes under (must match zigbee2mqtt configuration.yaml).
Z2M_BASE_TOPIC=zigbee2mqtt

# Directory for hub state that must survive restarts: the database, the hub
# identity, the Matter fabric storage, the pairing code.
DATA_DIR=./data

# Friendly hub name shown in discovery and apps.
HUB_NAME=GetHome Hub

# Set to 0 to disable a protocol adapter at boot. Disabling one also keeps its
# code out of memory — the adapters are imported on demand.
ADAPTER_ZIGBEE=1
ADAPTER_MQTT=1
ADAPTER_MATTER=1

# Set to 0 to disable mDNS (_gethome._tcp) advertisement.
MDNS=1

# Who answers mDNS for this machine.
#   auto  — avahi when it's installed (every Raspberry Pi OS), otherwise ciao
#   avahi — publish a static service file for the system responder
#   ciao  — run our own responder in-process
#   off
# Never run two responders on one host: both publish an A record for the
# machine's own name, mDNS calls that a conflict, and the loser renames itself.
# That is what used to make a Pi stop answering to raspberrypi.local after a
# power cut while keeping its IP address.
MDNS_BACKEND=auto
# AVAHI_SERVICES_DIR=/etc/avahi/services

# Log level: trace|debug|info|warn|error
# At trace/debug the API logs every request; above that it doesn't, because on
# a hub that is simply working those are thousands of "200 OK" lines a day
# written to an SD card.
LOG_LEVEL=info

# NOTE: the AI credential (an Anthropic API key) is NOT configured here. It is
# set at runtime through the API (PUT /api/v1/settings/ai) by the hub owner and
# stored encrypted in the database. See docs/ai-adaptation.md.
