# GetHome Hub configuration.
# Copy to .env for local development (npm run dev reads it via --env-file-if-exists).
# On a Pi, deploy/install.sh writes the same settings to /etc/gethome/hub.env.

# HTTP API + WebSocket port.
PORT=8420

# Which interface to listen on. Every interface by default, which is what a hub
# on a home network wants — a phone finds it over the same Wi-Fi. Narrow it only
# when the board is on a network it has no business serving (a hub that should
# answer on Ethernet or over a VPN and nowhere else). This is a narrowing, not a
# security boundary: the boundary is still your router.
# BIND_ADDRESS=0.0.0.0

# Extra names this hub answers to.
#
# The hub refuses a request whose Host header is a registrable public domain,
# which is what closes DNS rebinding — a page on the internet that points its
# own name at your hub's LAN address so your browser treats the two as one
# origin. Addresses, `localhost`, a bare machine name and anything under
# `.local` are recognised without being listed, so every ordinary hub leaves
# this empty and both apps work untouched.
#
# Set it only if you reach your hub by a real domain resolved to a LAN address
# inside your house (`hub.example.com` -> 192.168.1.50). Comma separated. `*`
# switches the check off, for a hub deliberately put behind a proxy.
# EXTRA_ALLOWED_HOSTS=

# Where the hub's SQLite file lives. Defaults to <DATA_DIR>/hub.db, which is
# almost always what you want — there is no server to point at.
# DATABASE_FILE=./data/hub.db

# MQTT broker (Mosquitto). Zigbee2MQTT and GetHome MQTT integrations meet here.
MQTT_URL=mqtt://127.0.0.1:1883

# Base topic Zigbee2MQTT publishes under (must match zigbee2mqtt configuration.yaml).
Z2M_BASE_TOPIC=zigbee2mqtt

# Zigbee2MQTT's own data directory. The hub reads one thing from it: when the
# radio is enabled but not connected, Z2M's newest log says why, and that
# answer belongs in GET /hub rather than in a journal on the Pi. Point this at
# the real directory or `zigbee.problem` diagnoses nothing.
# Z2M_DATA_DIR=/var/lib/gethome/zigbee2mqtt

# Directory for hub state that must survive restarts: the database, the hub
# identity, the Matter fabric storage, the pairing code.
DATA_DIR=./data

# The hub's name — which is also the home's name, since one hub hosts one home.
# Shown in the apps, in discovery, and in the mDNS advertisement.
#
# This only *seeds* it, on the first boot of a hub that has never had a name.
# After that the name is stored in the database and changed from the apps
# (PATCH /home); editing this line on a running hub does nothing.
HUB_NAME=My Home

# Set to 0 to disable a protocol adapter at boot. Disabling one also keeps its
# code out of memory — the adapters are imported on demand.
ADAPTER_ZIGBEE=1
ADAPTER_MQTT=1
ADAPTER_MATTER=1

# Whether this machine can afford both radios at once, measured from its RAM by
# deploy/install.sh — `both`, or `one` for a 512 MB board where Matter and
# Zigbee2MQTT do not fit together. This is a budget, not a preference: which
# radio a one-radio board runs is the owner's choice, lives in
# <DATA_DIR>/radio-mode, and is applied by gethome-zigbee-detect. Don't set it
# by hand on a Pi — the installer owns this line in /etc/gethome/hub.env.
GETHOME_RADIO=both

# Set to 0 to disable mDNS (_gethome._tcp) advertisement.
MDNS=1

# Who answers mDNS for this machine.
#   auto  — avahi when it's installed (every Raspberry Pi OS), otherwise ciao
#   avahi — publish a static service file for the system responder
#   ciao  — run our own responder in-process
#   off
# Never run two responders on one host: both publish an A record for the
# machine's own name, mDNS calls that a conflict, and the loser renames itself.
# That is what used to make a Pi stop answering to raspberrypi.local after a
# power cut while keeping its IP address.
MDNS_BACKEND=auto
# AVAHI_SERVICES_DIR=/etc/avahi/services

# Log level: trace|debug|info|warn|error
# At trace/debug the API logs every request; above that it doesn't, because on
# a hub that is simply working those are thousands of "200 OK" lines a day
# written to an SD card.
LOG_LEVEL=info

# NOTE: the AI credential (an Anthropic API key) is NOT configured here. It is
# set at runtime through the API (PUT /api/v1/settings/ai) by the hub owner and
# stored encrypted in the database. See docs/ai-adaptation.md.
