# GetHome Hub configuration.
# Copy to .env for local development (npm run dev reads it via --env-file-if-exists).
# docker-compose.yml sets these for containerized runs.

# HTTP API + WebSocket port.
PORT=8420

# Postgres connection string.
DATABASE_URL=postgres://gethome:gethome@127.0.0.1:5432/gethome

# MQTT broker (Mosquitto). Zigbee2MQTT and GetHome MQTT integrations meet here.
MQTT_URL=mqtt://127.0.0.1:1883

# Base topic Zigbee2MQTT publishes under (must match zigbee2mqtt configuration.yaml).
Z2M_BASE_TOPIC=zigbee2mqtt

# Directory for hub state that must survive restarts (hub identity, Matter fabric storage,
# pairing code). The Docker image mounts a volume here.
DATA_DIR=./data

# Friendly hub name shown in discovery and apps.
HUB_NAME=GetHome Hub

# Set to 0 to disable a protocol adapter at boot.
ADAPTER_ZIGBEE=1
ADAPTER_MQTT=1
ADAPTER_MATTER=1

# Set to 0 to disable mDNS (_gethome._tcp) advertisement.
MDNS=1

# Log level: trace|debug|info|warn|error
LOG_LEVEL=info

# NOTE: the AI credential (an Anthropic API key or a Claude subscription
# token) is NOT configured here. It is set at runtime through the API
# (PUT /api/v1/settings/ai) by the hub owner and stored encrypted in the
# database. See docs/ai-adaptation.md.
